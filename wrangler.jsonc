{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "student-event-planning-system",
  "main": "worker.js",
  "compatibility_date": "2026-11-12",
  "assets": { "directory": "./public", "binding": "ASSETS", "run_worker_first": ["/*"] },
  "d1_databases": [{ "binding": "DB", "database_name": "seps-db", "database_id": "4e478b12-af67-4e8a-ba97-86f79a6ec926", "migrations_dir": "./migrations" }],
  "ratelimits": [
    { "name": "AUTH_IP_LIMIT", "namespace_id": "348791", "simple": { "limit": 20, "period": 60 } },
    { "name": "AUTH_ACCOUNT_LIMIT", "namespace_id": "348792", "simple": { "limit": 10, "period": 60 } }
  ]
}
