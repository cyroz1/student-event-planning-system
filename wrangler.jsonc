{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "student-event-planning-system",
  "main": "worker.js",
  "compatibility_date": "2026-11-12",
  "assets": { "directory": "./public", "binding": "ASSETS", "run_worker_first": ["/api/*"] },
  "d1_databases": [{ "binding": "DB", "database_name": "seps-db", "database_id": "4e478b12-af67-4e8a-ba97-86f79a6ec926" }]
}

